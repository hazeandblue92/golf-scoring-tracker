# ── Public web variables (safe to expose in the browser bundle) ──────────────
# Supabase project URL
VITE_SUPABASE_URL=
# Supabase publishable (anon) key — public by design; RLS enforces access
VITE_SUPABASE_PUBLISHABLE_KEY=
# Release version stamped into the bundle (set by CI)
VITE_RELEASE_VERSION=0.0.0-dev
# Optional Web Push VAPID public key (Phase 2)
VITE_VAPID_PUBLIC_KEY=

# ── Secrets (never bundled, never committed; vendor secret stores only) ─────
# Supabase service-role key — Edge Function / CI secret ONLY
SUPABASE_SERVICE_ROLE_KEY=
# Direct database connection string (migrations, backups)
SUPABASE_DB_URL=
# Supabase access token for CLI deploys
SUPABASE_ACCESS_TOKEN=
# Cloudflare Pages deploy credentials (scoped token)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
# Web Push VAPID private key (Phase 2)
VAPID_PRIVATE_KEY=
# age public recipient key for encrypted backups (private key never in CI)
BACKUP_AGE_RECIPIENT=
