# Public web configuration. The publishable key is intentionally safe to ship;
# authorization still depends on JWTs and database Row Level Security.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_RELEASE_VERSION=0.1.0

# Local verification only. Never prefix private values with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-only

# Backup workflow secrets belong in GitHub Actions, never in this file.
# SUPABASE_DB_URL
# AGE_BACKUP_RECIPIENT

# Restore drills keep the private age identity only on the operator's machine.
# AGE_IDENTITY_FILE=/absolute/path/to/owner-backup-key.txt
