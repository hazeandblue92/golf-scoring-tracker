{
  "name": "golf-tournament-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Golf Tournament Tracker — zero-cost, offline-first golf league and tournament live scoring PWA",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:start": "node scripts/check-disk-space.mjs && supabase start",
    "backend:seed": "node scripts/check-disk-space.mjs && supabase db reset",
    "web:start": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web --if-present",
    "typecheck": "tsc -p packages/scoring && tsc -p packages/contracts && tsc -p packages/test-vectors",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "check:disk": "node scripts/check-disk-space.mjs",
    "test:integration": "vitest run --root tests/integration",
    "test:bootstrap:fresh": "vitest run --root tests/bootstrap fresh-owner.test.ts",
    "test:bootstrap:existing": "vitest run --root tests/bootstrap existing-league-owner.test.ts",
    "test:restore:fresh": "PORTABLE_RESTORE_FRESH_TARGET=1 vitest run --root tests/integration test/portable-restore-atomic.test.ts",
    "test:e2e": "playwright test",
    "test:security": "node --test scripts/test/security-secret-scan.test.mjs scripts/test/bootstrap-owner.test.mjs && node scripts/check-security-headers.mjs",
    "verify:deployment": "node scripts/check-deployed-headers.mjs",
    "test:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "test:licenses": "node scripts/check-licenses.mjs",
    "load:prepare-local": "node --experimental-strip-types scripts/prepare-capacity-fixture.mjs",
    "load:capacity": "node scripts/load-capacity.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "restore:backup": "node scripts/restore-backup.mjs",
    "restore:export": "node scripts/restore-export.mjs",
    "typecheck:functions": "cd supabase/functions && deno check $(ls -d */ | sed \"s#/##\" | while read d; do [ -f \"$d/index.ts\" ] && echo \"$d/index.ts\"; done)"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@supabase/server": "1.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "eslint": "^10.9.1",
    "fast-check": "4.9.0",
    "supabase": "^2.116.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  }
}
